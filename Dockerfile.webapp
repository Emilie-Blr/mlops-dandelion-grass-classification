# Base image
FROM python:3.9-slim

# Set working directory
WORKDIR /app

# Install system dependencies (pour Pillow, etc.)
RUN apt-get update && apt-get install -y \
    libjpeg-dev \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# === CORRECTION ICI ===
# Copier le BON fichier de requirements
COPY requirements-webapp.txt .

# Installer les BONNES dépendances
RUN pip install --no-cache-dir -r requirements-webapp.txt

# Copier le code source de la webapp
COPY src/webapp/ ./src/webapp/
COPY src/config.py ./src/config.py

# Expose port
EXPOSE 8501

# Commande de démarrage
CMD ["streamlit", "run", "src/webapp/app_pro.py", "--server.port=8501", "--server.address=0.0.0.0"]